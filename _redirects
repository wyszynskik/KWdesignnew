#
# Format: [source] [destination] [HTTP code]
# Kod 301 = stałe przekierowanie
# Kod 302 = tymczasowe
# Kod 200 = rewrite (bez zmiany URL w pasku)

###############################################################################
# STRONY, KTÓRE MOGĄ BYĆ POD STARYMI URL-AMI
###############################################################################

# Stare/alternatywne nazwy → właściwe (jeśli były kiedyś używane)
/omnie.html        /portfolio    301
/kontakt.html      /#contact 301
/omnie             /portfolio    301

###############################################################################
# CZYSTE URL-E – kanonizacja starych adresów z .html na wersje bez rozszerzenia
###############################################################################
# Cloudflare Pages i tak serwuje /portfolio.html pod adresem /portfolio,
# ale te reguły 301 przenoszą stare zaindeksowane/zakładkowane linki *.html
# na kanoniczną, czystą wersję (bez zmiany treści, tylko URL w pasku).

/index.html                          /                                    301
/portfolio.html                      /portfolio                          301
/uslugi.html                         /uslugi                             301
/narzedzie.html                      /narzedzie                          301
/polityka-prywatnosci.html           /polityka-prywatnosci               301
